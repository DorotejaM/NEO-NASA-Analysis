  <worksheets>
    <worksheet name='Cumul haz'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Tableau Regular' fontsize='10'>Cumulative hazardous objects</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='neo2_clean (NEO2)' name='federated.17zvj0d09i8o9b164at7n0r5yyoo' />
          </datasources>
          <datasource-dependencies datasource='federated.17zvj0d09i8o9b164at7n0r5yyoo'>
            <column caption='Cumulative Hazardous Objects' datatype='integer' name='[Calculation_589971552483450882]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(SUM(IF [is_hazardous] = &apos;True&apos; THEN 1 END))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Is Hazardous' datatype='string' name='[is_hazardous]' role='dimension' type='nominal' />
            <column-instance column='[is_hazardous]' derivation='None' name='[none:is_hazardous:nk]' pivot='key' type='nominal' />
            <column-instance column='[year]' derivation='None' name='[none:year:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_589971552483450882]' derivation='User' name='[usr:Calculation_589971552483450882:qk:4]' pivot='key' type='quantitative'>
              <table-calc ordering-field='[federated.17zvj0d09i8o9b164at7n0r5yyoo].[year]' ordering-type='Field' />
