    <worksheet name='Haz per yr and dist'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Regular' fontsize='10'>Hazardous NEOs per year and distance</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='neo2_clean (NEO2)' name='federated.17zvj0d09i8o9b164at7n0r5yyoo' />
          </datasources>
          <datasource-dependencies datasource='federated.17zvj0d09i8o9b164at7n0r5yyoo'>
            <column caption='miss_distance_category' datatype='string' name='[Calculation_392939132581789696]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [miss_distance] &lt;= 2900000 THEN &quot;Very Close&quot;&#13;&#10;ELSEIF [miss_distance] &lt;= 7100000 THEN &quot;Close&quot;&#13;&#10;ELSEIF [miss_distance] &lt;= 14400000 THEN &quot;Moderate&quot;&#13;&#10;ELSEIF [miss_distance] &lt;= 29000000 THEN &quot;Far&quot;&#13;&#10;ELSE &quot;Very Far&quot;&#13;&#10;END' />
              <aliases>
                <alias key='&quot;Close&quot;' value='Close (1–5 M km)' />
                <alias key='&quot;Far&quot;' value='Far (10–30 M km)' />
                <alias key='&quot;Moderate&quot;' value='Moderate (5–10 M km)' />
                <alias key='&quot;Very Close&quot;' value='Very Close (≤ 1 M km)' />
                <alias key='&quot;Very Far&quot;' value='Very Far (&gt; 30 M km)' />
              </aliases>
            </column>
            <column-instance column='[is_hazardous]' derivation='Count' name='[cnt:is_hazardous:qk]' pivot='key' type='quantitative' />
            <column-instance column='[is_hazardous]' derivation='Count' name='[cum:cnt:is_hazardous:qk]' pivot='key' type='quantitative'>
              <table-calc aggregation='Sum' ordering-type='Rows' type='CumTotal' />
            </column-instance>
            <column caption='Is Hazardous' datatype='string' name='[is_hazardous]' role='dimension' type='nominal' />
            <column caption='Miss Distance' datatype='real' name='[miss_distance]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_392939132581789696]' derivation='None' name='[none:Calculation_392939132581789696:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_hazardous]' derivation='None' name='[none:is_hazardous:nk]' pivot='key' type='nominal' />
            <column-instance column='[year]' derivation='None' name='[none:year:qk]' pivot='key' type='quantitative' />
            <column caption='Year' datatype='integer' name='[year]' role='dimension' type='quantitative' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.17zvj0d09i8o9b164at7n0r5yyoo].[cnt:is_hazardous:qk]' included-values='in-range-or-null'>
            <min>10</min>
            <max>875</max>
          </filter>
          <filter class='categorical' column='[federated.17zvj0d09i8o9b164at7n0r5yyoo].[none:Calculation_392939132581789696:nk]'>
            <groupfilter function='level-members' level='[none:Calculation_392939132581789696:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <manual-sort column='[federated.17zvj0d09i8o9b164at7n0r5yyoo].[none:Calculation_392939132581789696:nk]' direction='ASC'>
