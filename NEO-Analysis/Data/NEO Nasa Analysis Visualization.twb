      <aliases enabled='yes' />
      <column datatype='integer' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(COUNT([is_hazardous]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='integer' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(COUNT([is_hazardous]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='miss_distance_category' datatype='string' name='[Calculation_392939132581789696]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [miss_distance] &lt;= 2900000 THEN &quot;Very Close&quot;&#13;&#10;ELSEIF [miss_distance] &lt;= 7100000 THEN &quot;Close&quot;&#13;&#10;ELSEIF [miss_distance] &lt;= 14400000 THEN &quot;Moderate&quot;&#13;&#10;ELSEIF [miss_distance] &lt;= 29000000 THEN &quot;Far&quot;&#13;&#10;ELSE &quot;Very Far&quot;&#13;&#10;END' />
        <aliases>
          <alias key='&quot;Close&quot;' value='Close (1–5 M km)' />
          <alias key='&quot;Far&quot;' value='Far (10–30 M km)' />
          <alias key='&quot;Moderate&quot;' value='Moderate (5–10 M km)' />
          <alias key='&quot;Very Close&quot;' value='Very Close (≤ 1 M km)' />
          <alias key='&quot;Very Far&quot;' value='Very Far (&gt; 30 M km)' />
        </aliases>
      </column>
      <column caption='neo2_clean' datatype='table' name='[__tableau_internal_object_id__].[neo2!clean_838A88B5C9BD4E199C6C6AD968040622]' role='measure' type='quantitative' />
