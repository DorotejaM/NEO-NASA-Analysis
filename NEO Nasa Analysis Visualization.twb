      <column caption='Is Hazardous' datatype='string' name='[is_hazardous]' role='dimension' type='nominal' />
      <column caption='Miss Distance' datatype='real' name='[miss_distance]' role='measure' type='quantitative' />
      <column caption='Name' datatype='string' name='[name]' role='dimension' type='nominal' />
      <column caption='Neo Id' datatype='integer' name='[neo_id]' role='dimension' type='ordinal' />
      <column caption='Rel Velocity' datatype='real' name='[rel_velocity]' role='measure' type='quantitative' />
      <column caption='Year' datatype='integer' name='[year]' role='dimension' type='quantitative' />
      <column-instance column='[is_hazardous]' derivation='None' name='[none:is_hazardous:nk]' pivot='key' type='nominal' />
      <column-instance column='[year]' derivation='None' name='[none:year:ok]' pivot='key' type='ordinal' />
      <group caption='Action (Is Hazardous,Year)' hidden='true' name='[Action (Is Hazardous,Year)]' name-style='unqualified' user:auto-column='sheet_link'>
