      <table>
        <view>
          <datasources>
            <datasource caption='neo2_clean (NEO2)' name='federated.17zvj0d09i8o9b164at7n0r5yyoo' />
          </datasources>
          <datasource-dependencies datasource='federated.17zvj0d09i8o9b164at7n0r5yyoo'>
            <column caption='Cumulative Hazardous Objects' datatype='integer' name='[Calculation_589971552483450882]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(SUM(IF [is_hazardous] = &apos;True&apos; THEN 1 END))'>
